# Local development for `npm run dev:server` (copy to .env).
# On Railway, set these as service variables instead.

# Postgres — on Railway use ${{Postgres.DATABASE_URL}} (private network, no TLS needed)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/allez
# PGSSL=true            # only if connecting via a public proxy URL that requires TLS

# Optional AI tutor (server-side only, never exposed to the browser)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5      # claude-haiku-5-5 is far cheaper
# AI_DAILY_LIMIT=40             # requests per learner per day

PORT=3000

# Restrict accounts to these email domains (comma-separated). Empty = anyone.
# ALLOWED_EMAIL_DOMAINS=emason.com.au

# Email for 6-digit verification + password reset codes (pick one provider)
# POSTMARK_SERVER_TOKEN=
# RESEND_API_KEY=
# EMAIL_FROM=Allez ! <learn@emason.com.au>
